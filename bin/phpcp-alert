#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * phpcp-alert — sends a notification when one of the panel's systemd units fails (PLAN-V2 phase E6)
 *
 * Called by `phpcp-agentd.service`'s own `OnFailure=`, never by a person
 *
 * **Why this has to be a separate program, not a scheduler job:** when
 * `phpcp-agentd` dies, nothing else in the system can send a notification at all —
 *
 *   · `alert.check` is a capability that runs **through the agent**, so it can never be called in the first place
 *   · `phpcp-scheduler` is hardened with `RestrictAddressFamilies=AF_UNIX`
 *     (can't open TCP → Telegram/webhook is dead) and `NoNewPrivileges=yes`
 *     (disables postdrop's setgid → can't queue mail)
 *
 * Both of those restrictions are correct and must never be loosened just for
 * the convenience of notifications (§7.1, item 2) · so this program runs as
 * root in its own process, does exactly one thing — sends the message — then exits
 *
 * Deliberately kept narrow: **never touches the system in any other way** —
 * no commands, no file edits, no restarts — only reads settings and writes
 * `alert_state` · the program systemd calls while the system is already having a problem
 * must be the single hardest thing in the system to break, never a program that tries to recover the situation on its own
 *
 * Usage:
 *   phpcp-alert unit-failed <unit name>    Reports that unit as failed
 *   phpcp-alert test                       Sends a test message (used to verify the install is correct)
 */

if (PHP_VERSION_ID < 80200) {
    $candidates = ['/usr/bin/php8.5', '/usr/bin/php8.4', '/usr/bin/php8.3', '/usr/bin/php8.2'];

    foreach ($candidates as $binary) {
        if (!is_executable($binary) || realpath($binary) === realpath(PHP_BINARY)) {
            continue;
        }

        $argv[0] = __FILE__;
        pcntl_exec($binary, $argv);

        $command = escapeshellarg($binary);
        foreach ($argv as $arg) {
            $command .= ' ' . escapeshellarg($arg);
        }

        passthru($command, $code);
        exit($code);
    }

    fwrite(STDERR, sprintf(
        "phpcp-alert requires PHP 8.2 or newer, but %s is version %s\n",
        PHP_BINARY,
        PHP_VERSION,
    ));
    exit(1);
}

require dirname(__DIR__) . '/bootstrap.php';

use Phpcp\Agent\Executor\RealExecutor;
use Phpcp\Domain\AlertRules;
use Phpcp\Domain\Notifier;
use Phpcp\Kernel\App;

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit("phpcp-alert can only be used from the command line\n");
}

/**
 * Must never fail loudly — systemd calls this program while the system is already having a problem
 * If this died with a fatal error, that would just be one more failed unit added, with nothing gained in return
 */
try {
    $action = $argv[1] ?? '';
    $unit = trim((string) ($argv[2] ?? ''));

    $app = App::boot(dirname(__DIR__));
    $db = $app->db();

    // Runs as root, so it can send through every channel, including email, which has to call sendmail via Executor
    $notifier = new Notifier($db, new RealExecutor());

    if ($action === 'test') {
        $channels = $notifier->activeChannels();

        if ($channels === []) {
            fwrite(STDERR, "No notification channel is fully configured yet — set one up on the panel's \"Settings\" page first\n");
            exit(1);
        }

        $sent = $notifier->send(
            'alert',
            'Testing the service-failure notification',
            "If you received this message, phpcp-alert is working\n"
            . 'The system uses this path to notify when phpcp-agentd fails, which is exactly the moment every other channel stops working',
            'ok',
        );

        printf("Working channels: %s\nSend result: %s\n", implode(', ', $channels), $sent ? 'success' : 'failed');
        exit($sent ? 0 : 1);
    }

    /*
     * fail2ban in "notify but don't ban" mode calls this command instead of issuing a firewall command
     *
     * **Why this program specifically** — fail2ban runs as root but can't
     * call an agent capability (doesn't know the socket, and shouldn't) ·
     * this program does exactly what's needed: sends a message, then stops
     * — never touching the system in any other way, which was already its intent from the start
     *
     * The admin is the one who decides whether to ban or not, so the message
     * must carry the ban command along with it — someone reading a
     * notification at 2am shouldn't have to go dig through a manual for the syntax
     */
    if ($action === 'jail-hit') {
        $jail = trim((string) ($argv[2] ?? ''));
        $ip = trim((string) ($argv[3] ?? ''));
        $failures = (int) ($argv[4] ?? 0);

        if ($jail === '' || filter_var($ip, FILTER_VALIDATE_IP) === false) {
            fwrite(STDERR, "Usage: phpcp-alert jail-hit <jail> <ip> [failure count]\n");
            exit(2);
        }

        // Guards against spam with the same mechanism as every other
        // threshold — an IP hitting repeatedly would trip the threshold
        // again and again · without this, the notification becomes something turned off within a single night
        $decision = (new AlertRules($db))->evaluate('jail:' . $jail . ':' . $ip, 'warning', (float) $failures);

        if (!$decision['notify']) {
            exit(0);
        }

        $sent = $notifier->send(
            'security',
            sprintf('Attack detected from %s', $ip),
            sprintf(
                "jail: %s\nAddress: %s\nFailures that crossed the threshold: %d\nMachine: %s\n\n"
                . "**Not yet banned** — this jail is set to notify-only mode\n\n"
                . "To ban right now:\n"
                . "  sudo fail2ban-client set %s banip %s\n\n"
                . 'If this is a genuine user (such as a whole organization sharing one outbound IP), '
                . 'add this address to the "addresses that must never be banned" field on the Security page',
                $jail,
                $ip,
                $failures,
                gethostname() ?: 'unknown hostname',
                $jail,
                $ip,
            ),
            'warning',
        );

        exit($sent ? 0 : 0);   // A failed send is never fail2ban's own failure
    }

    if ($action !== 'unit-failed' || $unit === '') {
        fwrite(STDERR, "Usage: phpcp-alert unit-failed <unit name>  |  phpcp-alert jail-hit <jail> <ip> [count]  |  phpcp-alert test\n");
        exit(2);
    }

    // Uses the same anti-spam mechanism as every other threshold — a unit
    // stuck in a restart loop (Restart=on-failure) would call this program
    // on every single failure, and without this, that becomes dozens of messages within a few minutes
    $decision = (new AlertRules($db))->evaluate('unit:' . $unit, 'critical', 0.0);

    if (!$decision['notify']) {
        exit(0);
    }

    $body = $unit === 'phpcp-agentd.service'
        ? "phpcp-agentd failed — **every one of the panel's commands has stopped working**\n\n"
          . "Immediate impact:\n"
          . "  · The web page can't issue any command at all\n"
          . "  · The firewall/SSH automatic rollback mechanism has nothing to trigger it — if a change was left pending, you may be locked out of the machine permanently\n"
          . "  · Every scheduled job is failing, including backups and certificate renewal\n\n"
          . "Check with: sudo systemctl status phpcp-agentd\n"
          . 'Fix with: sudo systemctl restart phpcp-agentd'
        : sprintf(
            "systemd unit %s failed on machine %s\n\nCheck with: sudo systemctl status %s",
            $unit,
            gethostname() ?: 'unknown hostname',
            $unit,
        );

    $notifier->send('alert', sprintf('Service %s failed', $unit), $body, 'danger');

    exit(0);
} catch (\Throwable $e) {
    // Only writes to stderr — journalctl already captures it, and writing a
    // log file itself could fail again if the root cause is a full disk, which is one of the reasons a unit fails in the first place
    fwrite(STDERR, 'phpcp-alert failed: ' . $e->getMessage() . "\n");
    exit(1);
}
