#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * phpcp-agentd — layer 2 of the architecture (ARCHITECTURE §4)
 *
 * Runs as root on a real server, and can run as an ordinary user in sandbox
 * mode, which is why the whole system can be tested on a developer's machine with no sudo needed
 *
 * Usage:
 *   phpcp-agentd                 Runs and stays up (this is how systemd calls it)
 *   phpcp-agentd --check         Checks readiness, then exits
 */

/**
 * The version gate — must sit before every single require
 *
 * The rest of the code uses readonly classes, which have existed since PHP
 * 8.2 · if the system's `php` is older than that, the require dies with a
 * parse error that gives no clue at all what needs fixing
 *
 * Genuinely happened on Ubuntu 22.04: the installer correctly picked php8.4
 * from ppa:ondrej/php to use, but the `php` an admin types themselves still
 * pointed at the distro's own 8.1 — a recovery command like `phpcp
 * user:passwd` stopped working at exactly the moment it was needed most
 *
 * So this file looks for a binary new enough and re-executes itself with
 * it, instead of just reporting that the version is wrong · the code in
 * this block must be written in syntax old PHP can still read too
 */
if (PHP_VERSION_ID < 80200) {
    $candidates = ['/usr/bin/php8.5', '/usr/bin/php8.4', '/usr/bin/php8.3', '/usr/bin/php8.2'];

    foreach ($candidates as $binary) {
        if (!is_executable($binary)) {
            continue;
        }

        // Guards against looping forever if the binary found turns out to be the same one
        if (realpath($binary) === realpath(PHP_BINARY)) {
            continue;
        }

        $argv[0] = __FILE__;
        pcntl_exec($binary, $argv);   // Falls through to passthru below if pcntl isn't available

        $command = escapeshellarg($binary);
        foreach ($argv as $arg) {
            $command .= ' ' . escapeshellarg($arg);
        }

        passthru($command, $code);
        exit($code);
    }

    fwrite(STDERR, sprintf(
        "phpcp requires PHP 8.2 or newer, but %s is version %s\n"
        . "and no binary new enough was found on this machine\n\n"
        . "Ubuntu 22.04: sudo add-apt-repository ppa:ondrej/php && sudo apt install php8.3-cli\n",
        PHP_BINARY,
        PHP_VERSION,
    ));
    exit(1);
}

require dirname(__DIR__) . '/bootstrap.php';

use Phpcp\Agent\CapabilityRegistry;
use Phpcp\Agent\Server;
use Phpcp\Kernel\App;
use Phpcp\Kernel\Logger;

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "phpcp-agentd can only be run from the command line\n");
    exit(1);
}

foreach (['pcntl', 'posix', 'sockets'] as $extension) {
    if (!extension_loaded($extension)) {
        fwrite(STDERR, "Required PHP extension: {$extension}\n");
        exit(1);
    }
}

try {
    $app = App::boot();
    $config = $app->config;
    $config->paths->ensureDirectories();

    $logger = new Logger(
        $config->paths->logFile('agent'),
        $config->string('log.level', 'info'),
        alsoStderr: true,
    );

    $registry = new CapabilityRegistry();

    if (in_array('--check', $argv, true)) {
        printf("Mode          : %s\n", $config->mode->label());
        printf("Socket        : %s\n", $config->agentSocket());
        printf("Database      : %s\n", $config->paths->database());
        printf("Capabilities  : %d\n", count($registry->names()));
        printf("Current user  : uid=%d\n", posix_geteuid());

        if ($config->mode->isProduction() && posix_geteuid() !== 0) {
            fwrite(STDERR, "Warning: production mode must run with root privileges\n");
            exit(1);
        }

        echo "Ready\n";
        exit(0);
    }

    // Production mode not running as root can never genuinely work — better to refuse up front than fail partway through
    if ($config->mode->isProduction() && posix_geteuid() !== 0) {
        fwrite(STDERR, "phpcp-agentd in production mode must run with root privileges\n");
        exit(1);
    }

    $server = new Server($config, $logger, $registry);

    exit($server->run());
} catch (\Throwable $e) {
    fwrite(STDERR, 'phpcp-agentd failed to start: ' . $e->getMessage() . "\n");
    exit(1);
}
