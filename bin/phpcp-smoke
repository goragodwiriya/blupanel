#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Fires every REST API v2 endpoint at a genuinely running server
 *
 * **Why this exists when there are already 334 test cases**
 *
 * The contract tests build a `Request` in the same process — they never
 * travel through PHP-FPM, Apache, the web server's own middleware, or a
 * genuine session · a small difference between the simulation and the real
 * thing can hide an entire layer's worth of bugs, and it has happened before:
 *
 *   `Request::make()` sets Content-Type as `HTTP_CONTENT_TYPE`, but PHP-FPM
 *   sends it as `CONTENT_TYPE` per RFC 3875 → **every endpoint was completely
 *   unable to read a JSON body on the real machine**, while the tests passed
 *   333/333 · only found by clicking a button on the real server
 *
 * This is therefore the last gate before trusting that the API genuinely
 * works — especially before starting to write the SPA, which talks to the
 * API purely in JSON and would have no way to tell which layer the problem is in
 *
 * **Safety:** never creates or deletes real data
 *   - A route with a parameter → filled with an id that doesn't exist, expecting a 404
 *   - A data-changing route with no parameter → sent an empty body, expecting a 422
 *   - A route that destroys its own session (logout) → skipped
 * What's checked is "did the request reach the controller and answer per the contract," never a business outcome
 *
 * Usage:
 *   bin/phpcp-smoke --url=https://127.0.0.1:8443 --user=demo --password=xxx
 *   bin/phpcp-smoke --url=... --user=... --password-file=/path/to/file
 */

require __DIR__.'/../bootstrap.php';

use Phpcp\Http\ApiProblem;
use Phpcp\Kernel\Routes;

/** An id deliberately chosen not to exist — substituted for every parameter so a route answers 404 without touching data */
const MISSING_ID = '999999';

/**
 * Routes that must be skipped, with the reason why
 *
 * Kept to as few as possible — every line here is a spot this checker can't see into
 */
const SKIP = [
    'DELETE /api/v2/session' => 'Logs out, which would cause every remaining request to fail along with it',
    'POST /api/v2/session' => 'Logging in again would collide with the rate limit on the login route',
    'POST /api/v2/session/2fa' => 'Same reason as login',
];

/**
 * Routes that send data continuously with no end (Server-Sent Events)
 *
 * Can't be checked the same way as other routes, since the connection never
 * closes on its own — a short timeout is set instead, and the check is only
 * whether it started sending with the right type (deliberately not JSON)
 *
 * @var array<string,string>
 */
const STREAMING = [
    'GET /api/v2/metrics/stream' => 'text/event-stream',
];

$options = parseArguments($argv);

$base = rtrim((string) ($options['url'] ?? 'https://127.0.0.1:8443'), '/');
$username = (string) ($options['user'] ?? '');
$password = readPassword($options);

if ($username === '' || $password === '') {
    fwrite(STDERR, "--user and --password (or --password-file) are required\n");
    exit(2);
}

$client = new SmokeClient($base);

line('');
line("Firing REST API v2 at {$base}");
line(str_repeat('─', 62));

if (!$client->login($username, $password)) {
    fwrite(STDERR, "  ✘ Login failed — check the username and password\n");
    exit(1);
}

line("  ✔ Signed in as {$username}");
line('');

$results = [];

foreach (Routes::build()->routes() as $route) {
    if (!str_starts_with($route->path, '/api/v2')) {
        continue;
    }

    $key = $route->method.' '.$route->path;

    if (isset(SKIP[$key])) {
        $results[] = ['route' => $key, 'status' => 0, 'skip' => SKIP[$key], 'problems' => []];

        continue;
    }

    $url = preg_replace('/\{[^}]+\}/', MISSING_ID, $route->path) ?? $route->path;

    if (isset(STREAMING[$key])) {
        $response = $client->request($route->method, $url, timeout: 3);

        $results[] = [
            'route' => $key,
            'status' => $response['status'],
            'skip' => $response['status'] === 429 ? 'Rate-limited — not genuinely checked yet' : null,
            'problems' => $response['status'] === 429 ? [] : inspectStream($response, STREAMING[$key]),
        ];

        continue;
    }

    $response = $client->request($route->method, $url);

    $results[] = [
        'route' => $key,
        'status' => $response['status'],
        'skip' => $response['status'] === 429 ? 'Rate-limited — not genuinely checked yet' : null,
        'problems' => $response['status'] === 429 ? [] : inspect($route->method, $url, $response),
    ];
}

report($results);

// Counted as failed when there's a problem **or** when a route was never genuinely checked at all
$incomplete = array_filter(
    $results,
    static fn (array $r): bool => $r['problems'] !== [] || $r['status'] === 429,
);

exit($incomplete === [] ? 0 : 1);

// ---------------------------------------------------------------------------

/**
 * Checks whether a single response matches §4.2's contract
 *
 * @param array{status:int,body:string,contentType:string} $response
 * @return list<string> the list of problems — empty = passes
 */
function inspect(string $method, string $url, array $response): array
{
    $problems = [];

    // 500 is the first thing this checker exists to catch — it means the request died partway through
    if ($response['status'] >= 500) {
        $problems[] = "Answered {$response['status']} — the request failed partway through";
    }

    if (!str_contains(strtolower($response['contentType']), 'application/json')) {
        $problems[] = 'Did not answer as JSON, answered as '.($response['contentType'] ?: 'an unspecified type');

        return $problems;   // Can't check the shape any further if it isn't JSON
    }

    // 204 has no body, per the standard
    if ($response['status'] === 204) {
        return $problems;
    }

    $decoded = json_decode($response['body'], true);

    if (!is_array($decoded)) {
        $problems[] = 'The body is not decodable JSON';

        return $problems;
    }

    if (!array_key_exists('ok', $decoded)) {
        $problems[] = 'Missing the ok field required by §4.2';
    }

    if (($decoded['ok'] ?? true) === false) {
        $code = (string) (($decoded['error'] ?? [])['code'] ?? '');

        if (ApiProblem::tryFrom($code) === null) {
            $problems[] = "Uses an error code outside the enum: {$code}";
        }

        if ((string) (($decoded['error'] ?? [])['message'] ?? '') === '') {
            $problems[] = 'The error has no explanatory message';
        }
    }

    return $problems;
}

/**
 * A streaming route passes only if it started sending with the correct type
 *
 * curl always ends in a timeout (status 0), since the server side never
 * closes the connection — what can genuinely be proven is that the header
 * arrived and was correct, which means routing and permissions already passed
 *
 * @param array{status:int,body:string,contentType:string} $response
 * @return list<string>
 */
function inspectStream(array $response, string $expected): array
{
    if ($response['status'] >= 500) {
        return ["Answered {$response['status']} — the request failed partway through"];
    }

    if ($response['contentType'] === '' && $response['status'] === 0) {
        return ['Never started sending data at all within the time given'];
    }

    if (!str_contains(strtolower($response['contentType']), $expected)) {
        return ["Must start sending as {$expected} but got ".($response['contentType'] ?: 'an unspecified type')];
    }

    return [];
}

/** @param list<array{route:string,status:int,skip:?string,problems:list<string>}> $results */
function report(array $results): void
{
    $failed = 0;
    $skipped = 0;

    foreach ($results as $r) {
        if ($r['skip'] !== null) {
            $skipped++;
            line(sprintf('  ‒ %-52s skipped: %s', $r['route'], $r['skip']));

            continue;
        }

        if ($r['problems'] === []) {
            line(sprintf('  ✔ %-52s %d', $r['route'], $r['status']));

            continue;
        }

        $failed++;
        line(sprintf('  ✘ %-52s %d', $r['route'], $r['status']));

        foreach ($r['problems'] as $problem) {
            line('      '.$problem);
        }
    }

    $throttled = count(array_filter(
        $results,
        static fn (array $r): bool => $r['status'] === 429,
    ));

    $checked = count($results) - $skipped;

    line('');
    line(sprintf(
        ' Checked %d routes · passed %d · failed %d · skipped %d',
        $checked,
        $checked - $failed,
        $failed,
        $skipped,
    ));

    // If any route was rate-limited, the result isn't complete — this must
    // be stated clearly, not left to make the "passed" number look good
    // while those endpoints were never genuinely reached at the controller at all
    if ($throttled > 0) {
        line('');
        line(sprintf(' ⚠ %d routes were rate-limited — not yet proven, wait a moment and run again', $throttled));
    }

    line('');
}

function line(string $text): void
{
    fwrite(STDOUT, $text."\n");
}

/**
 * @param list<string> $argv
 * @return array<string,string>
 */
function parseArguments(array $argv): array
{
    $options = [];

    foreach (array_slice($argv, 1) as $argument) {
        if (preg_match('/^--([a-z-]+)=(.*)$/', $argument, $matches) === 1) {
            $options[$matches[1]] = $matches[2];
        }
    }

    return $options;
}

/**
 * A password from a file is better than from the command line, since argv shows up in `ps` for other users on the machine to see
 *
 * @param array<string,string> $options
 */
function readPassword(array $options): string
{
    if (isset($options['password-file'])) {
        $raw = @file_get_contents($options['password-file']);

        return $raw === false ? '' : trim($raw);
    }

    return (string) ($options['password'] ?? '');
}

/**
 * A request firer that stores cookies and the CSRF token, the same way a browser does
 *
 * Uses PHP's own curl directly, never the agent's Client — deliberately
 * travels the exact same path a real user would, including the TLS and Apache layers
 */
final class SmokeClient
{
    private string $cookieFile;

    private string $csrf = '';

    public function __construct(private readonly string $base)
    {
        $this->cookieFile = (string) tempnam(sys_get_temp_dir(), 'phpcp-smoke-');
    }

    public function __destruct()
    {
        @unlink($this->cookieFile);
    }

    public function login(string $username, string $password): bool
    {
        $this->request('GET', '/api/v2/session');

        $response = $this->request('POST', '/api/v2/session', [
            'username' => $username,
            'password' => $password,
        ]);

        return $response['status'] === 200;
    }

    /**
     * @param array<string,mixed>|null $body
     * @return array{status:int,body:string,contentType:string}
     */
    public function request(
        string $method,
        string $path,
        ?array $body = null,
        int $timeout = 20,
        bool $retry = true,
    ): array {
        $handle = curl_init($this->base.$path);

        $headers = ['Accept: application/json'];

        if ($this->csrf !== '') {
            $headers[] = 'X-CSRF-Token: '.$this->csrf;
        }

        // A data-changing route must always have a JSON body, even an empty
        // object — so it genuinely travels through the body converter, the exact layer that has broken entirely before
        if ($method !== 'GET' && $method !== 'HEAD') {
            $headers[] = 'Content-Type: application/json';
            curl_setopt($handle, CURLOPT_POSTFIELDS, json_encode($body ?? [], JSON_UNESCAPED_UNICODE));
        }

        curl_setopt_array($handle, [
            CURLOPT_CUSTOMREQUEST => $method,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HEADER => true,
            CURLOPT_HTTPHEADER => $headers,
            CURLOPT_COOKIEFILE => $this->cookieFile,
            CURLOPT_COOKIEJAR => $this->cookieFile,
            // The panel's certificate is self-signed at install time — this
            // checker fires at 127.0.0.1, so it was never relying on TLS for identity verification anyway
            CURLOPT_SSL_VERIFYPEER => false,
            CURLOPT_SSL_VERIFYHOST => 0,
            CURLOPT_TIMEOUT => $timeout,
            CURLOPT_FOLLOWLOCATION => false,
        ]);

        $raw = (string) curl_exec($handle);
        $status = (int) curl_getinfo($handle, CURLINFO_RESPONSE_CODE);
        $headerSize = (int) curl_getinfo($handle, CURLINFO_HEADER_SIZE);
        $contentType = (string) (curl_getinfo($handle, CURLINFO_CONTENT_TYPE) ?? '');

        curl_close($handle);

        $rawHeaders = substr($raw, 0, $headerSize);
        $responseBody = substr($raw, $headerSize);

        // A fresh token arrives with every v2 response — must be stored for the next request
        if (preg_match('/^x-csrf-token:\s*(\S+)/im', $rawHeaders, $matches) === 1) {
            $this->csrf = $matches[1];
        }

        // The rate limiter returns how long to wait — waits, then retries
        // once, so running this checker (which fires dozens of requests at
        // once) doesn't turn into an incomplete report
        if ($status === 429 && $retry) {
            preg_match('/^retry-after:\s*(\d+)/im', $rawHeaders, $wait);
            sleep(min(30, max(1, (int) ($wait[1] ?? 2))));

            return $this->request($method, $path, $body, $timeout, retry: false);
        }

        return ['status' => $status, 'body' => $responseBody, 'contentType' => $contentType];
    }
}
