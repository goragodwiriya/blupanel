#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * phpcp-acme-hook — answers Let's Encrypt's DNS-01 challenge using the machine's own BIND9 (PLAN-V2 phase E7)
 *
 * Called by certbot, never by a person, via `--manual-auth-hook` and
 * `--manual-cleanup-hook` · certbot passes values through **environment variables**, never arguments:
 *
 *   CERTBOT_DOMAIN      the domain currently being proven (never has a leading `*.`, even for a wildcard request)
 *   CERTBOT_VALIDATION  the value that must go into the TXT record at `_acme-challenge.<CERTBOT_DOMAIN>`
 *
 * **Why this has to be DNS-01:** a wildcard certificate (`*.example.com`) can
 * never be issued with HTTP-01 at all — Let's Encrypt requires DNS-01 only,
 * since proving control of a file on the website never proves control of the whole domain
 *
 * **Why not use the `certbot-dns-rfc2136` plugin:** it requires setting up a
 * TSIG key and keeping that key somewhere certbot can read it, which adds
 * another secret to maintain · this machine already owns the zone file (see
 * `BindZoneManager`), so writing the record directly is more straightforward and reuses the existing mechanism entirely
 *
 * Usage:
 *   phpcp-acme-hook auth      Adds the TXT record and waits until it's genuinely detected
 *   phpcp-acme-hook cleanup   Removes the TXT record that was added
 */

if (PHP_VERSION_ID < 80200) {
    $candidates = ['/usr/bin/php8.5', '/usr/bin/php8.4', '/usr/bin/php8.3', '/usr/bin/php8.2'];

    foreach ($candidates as $binary) {
        if (!is_executable($binary) || realpath($binary) === realpath(PHP_BINARY)) {
            continue;
        }

        $argv[0] = __FILE__;
        pcntl_exec($binary, $argv);

        $command = escapeshellarg($binary);
        foreach ($argv as $arg) {
            $command .= ' ' . escapeshellarg($arg);
        }

        passthru($command, $code);
        exit($code);
    }

    fwrite(STDERR, "phpcp-acme-hook requires PHP 8.2 or newer\n");
    exit(1);
}

require dirname(__DIR__) . '/bootstrap.php';

use Phpcp\Agent\Executor\RealExecutor;
use Phpcp\Domain\AcmeDnsChallenge;
use Phpcp\Kernel\App;

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit("phpcp-acme-hook can only be used from the command line\n");
}

try {
    $action = $argv[1] ?? '';
    $domain = trim((string) getenv('CERTBOT_DOMAIN'));
    $validation = trim((string) getenv('CERTBOT_VALIDATION'));

    if (!in_array($action, ['auth', 'cleanup'], true)) {
        fwrite(STDERR, "Usage: phpcp-acme-hook auth|cleanup  (reads values from CERTBOT_DOMAIN/CERTBOT_VALIDATION)\n");
        exit(2);
    }

    if ($domain === '') {
        fwrite(STDERR, "CERTBOT_DOMAIN not found — this program is only ever called by certbot\n");
        exit(2);
    }

    $app = App::boot(dirname(__DIR__));
    $challenge = new AcmeDnsChallenge($app->db(), $app->config, new RealExecutor());

    if ($action === 'auth') {
        // Must **wait until it's genuinely detected** before returning —
        // certbot treats a finished hook as meaning the record is ready to
        // use, and immediately asks Let's Encrypt to check · returning too
        // soon gets a "DNS problem: NXDOMAIN" error that points at a
        // misconfigured value, when really it just hasn't propagated yet
        $result = $challenge->publish($domain, $validation);

        printf(
            "Added TXT _acme-challenge.%s (serial %d) — detected after %d seconds\n",
            $result['domain'],
            $result['serial'],
            $result['waited'],
        );

        exit(0);
    }

    $result = $challenge->cleanup($domain);

    printf("Removed TXT _acme-challenge.%s (%d records)\n", $result['domain'], $result['removed']);

    exit(0);
} catch (\Throwable $e) {
    // certbot mainly reads the exit code, but the stderr text shows up in
    // its own log — the one place an admin will ever see why the certificate request failed
    fwrite(STDERR, 'phpcp-acme-hook failed: ' . $e->getMessage() . "\n");
    exit(1);
}
