#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * phpcp-scheduler — runs the panel's own scheduled jobs (PLAN-V2 phase A1)
 *
 * Called by phpcp-scheduler.timer every minute: reads the scheduled_jobs
 * table, finds jobs that are due, and issues them through the agent exactly as the web layer does
 *
 * The most important job is `rollback.run` — the automatic rollback
 * mechanism for SSH/firewall is designed for the case where an admin has
 * "already lost the connection," which means no browser request will ever
 * come in to trigger it · without a server-side timer, that mechanism doesn't genuinely exist
 *
 * Usage:
 *   phpcp-scheduler                Runs jobs that are due, one round (this is how systemd calls it)
 *   phpcp-scheduler --list         Shows every job with its most recent result
 *   phpcp-scheduler --run=jobName  Forces an immediate run, ignoring the schedule
 *   phpcp-scheduler --quiet        Prints nothing when no job is due
 */

/**
 * The version gate — must sit before every single require
 *
 * The full reason is in bin/phpcp: the `php` an admin types themselves might
 * be an older distro version than the code requires, dying with a parse
 * error that gives no clue at all · the code in this block must be written in syntax old PHP can still read too
 */
if (PHP_VERSION_ID < 80200) {
    $candidates = ['/usr/bin/php8.5', '/usr/bin/php8.4', '/usr/bin/php8.3', '/usr/bin/php8.2'];

    foreach ($candidates as $binary) {
        if (!is_executable($binary)) {
            continue;
        }

        if (realpath($binary) === realpath(PHP_BINARY)) {
            continue;
        }

        $argv[0] = __FILE__;
        pcntl_exec($binary, $argv);

        $command = escapeshellarg($binary);
        foreach ($argv as $arg) {
            $command .= ' ' . escapeshellarg($arg);
        }

        passthru($command, $code);
        exit($code);
    }

    fwrite(STDERR, sprintf(
        "phpcp-scheduler requires PHP 8.2 or newer, but %s is version %s\n",
        PHP_BINARY,
        PHP_VERSION,
    ));
    exit(1);
}

require dirname(__DIR__) . '/bootstrap.php';

use Phpcp\Agent\Actor;
use Phpcp\Domain\AgentHealth;
use Phpcp\Domain\Scheduler;
use Phpcp\Domain\ScheduledJobRepository;
use Phpcp\Kernel\App;
use Phpcp\Kernel\Logger;

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit("phpcp-scheduler can only be used from the command line\n");
}

$option = static function (array $argv, string $name): ?string {
    foreach ($argv as $arg) {
        if ($arg === $name) {
            return '';
        }
        if (str_starts_with($arg, $name . '=')) {
            return substr($arg, strlen($name) + 1);
        }
    }

    return null;
};

try {
    $app = App::boot();
    $config = $app->config;

    $jobs = new ScheduledJobRepository($app->db());

    // --- Listing --------------------------------------------------------
    if ($option($argv, '--list') !== null) {
        // printf counts width in bytes — since a Thai character costs 3
        // bytes, that would skew every row of the table, so padding is
        // filled in by hand, counted by character instead
        $pad = static fn (string $text, int $width): string
            => $text . str_repeat(' ', max(1, $width - mb_strlen($text)));

        echo $pad('Job', 16), $pad('Schedule', 16), $pad('Last status', 14),
             $pad('Last run', 22), "Error\n";

        foreach ($jobs->all() as $job) {
            echo $pad((string) $job['name'], 16),
                 $pad((string) $job['schedule'], 16),
                 $pad((int) $job['enabled'] === 1 ? (string) ($job['last_status'] ?? '—') : 'disabled', 14),
                 $pad(
                     $job['last_run_at'] === null ? 'never run' : date('Y-m-d H:i:s', (int) $job['last_run_at']),
                     22,
                 ),
                 (string) ($job['last_error'] ?? ''), "\n";
        }

        exit(0);
    }

    // --- Preparing to issue commands --------------------------------------
    $logger = new Logger(
        $config->paths->logFile('scheduler'),
        $config->string('log.level', 'info'),
    );

    $agent = $app->agent();

    // The one issuing the command is "the system," never any particular
    // user — the audit log records it that way, and the agent always
    // computes permissions from the role sent along, never trusting a permission list from this side
    $actor = Actor::system('scheduler');

    $scheduler = new Scheduler(
        $app->db(),
        static fn (string $capability, array $args): array => $agent->data($capability, $args, $actor),
        $logger,
    );

    // --- Forcing a single job to run --------------------------------------
    $forced = $option($argv, '--run');
    if ($forced !== null && $forced !== '') {
        $result = $scheduler->runNow($forced);

        printf("%s: %s (%s)\n", $result['name'], $result['status'], $result['message']);

        exit($result['status'] === 'error' ? 1 : 0);
    }

    // --- The normal round --------------------------------------------------
    //
    // Locked to prevent overlapping rounds: a job like disk.usage on a
    // machine with many websites can take longer than a minute — letting a
    // new round start on top would issue the same capability multiple times
    // at once, and last_run_at would get written in an interleaved order
    // that makes it impossible to tell what genuinely already ran
    $config->paths->ensureDirectories();
    $lockFile = $config->paths->run . '/scheduler.lock';
    $lock = @fopen($lockFile, 'c');

    if ($lock === false) {
        fwrite(STDERR, "Could not create the lock file: {$lockFile}\n");
        exit(1);
    }

    if (!flock($lock, LOCK_EX | LOCK_NB)) {
        // Not an error — the previous round is still running, this one steps back quietly
        exit(0);
    }

    $quiet = $option($argv, '--quiet') !== null;

    // --- Records the agent's status before issuing any command -------------
    //
    // Must sit **before** runDue(), since every job in the table travels
    // through the agent entirely — if the agent is down, the whole batch
    // fails in a row and gets recorded with the same last_error, which says nothing about the actual cause
    //
    // **Only records it, never sends a notification** — this process is
    // locked down to AF_UNIX (can't fire a Telegram message) and
    // NoNewPrivileges (can't queue mail) · sending the notification is
    // bin/phpcp-alert's job, which systemd calls via OnFailure= — see AgentHealth for the full picture
    //
    // A failure here must never stop the scheduler — scheduled jobs must always keep running
    try {
        $health = (new AgentHealth($app->db(), $agent))->check();

        if (!$health['available'] && !$quiet) {
            fwrite(STDERR, "The agent isn't responding — every scheduled job this round will fail\n");
        }
    } catch (\Throwable $e) {
        $logger->error('Failed to record the agent status: ' . $e->getMessage());
    }

    $results = $scheduler->runDue();

    flock($lock, LOCK_UN);
    fclose($lock);

    if ($results === []) {
        if (!$quiet) {
            echo "No job is due\n";
        }

        exit(0);
    }

    $failed = 0;
    foreach ($results as $result) {
        if ($result['status'] === 'error') {
            $failed++;
        }

        if (!$quiet || $result['status'] === 'error') {
            printf(
                "%-16s %-8s %s%s\n",
                $result['name'],
                $result['status'],
                $result['message'],
                $result['duration_ms'] > 0 ? ' (' . $result['duration_ms'] . ' ms)' : '',
            );
        }
    }

    exit($failed === 0 ? 0 : 1);
} catch (\Throwable $e) {
    fwrite(STDERR, 'phpcp-scheduler failed: ' . $e->getMessage() . "\n");
    exit(1);
}
