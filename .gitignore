# =============================================================================
# ห้าม commit ข้อมูลของเครื่องที่ติดตั้งจริง — เหตุผลเดียวกับ .dockerignore
# =============================================================================

# secret key ของ panel · ถ้าหลุดเข้า history = ปลอม session ได้ทุกบัญชี
etc/config.php

# ฐานข้อมูล · log · audit log · lock ของ scheduler · sandbox ของเครื่องพัฒนา
var/

# ผลสแกนความปลอดภัย — สร้างใหม่ได้ด้วย tools/security-audit.sh
# และมีรายละเอียดพอร์ต/บริการของเครื่องที่สแกน จึงไม่ควรอยู่ใน history
audit_*/

# ทั่วไป
*.log
*.db
*.sqlite
.DS_Store
node_modules/
