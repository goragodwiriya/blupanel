# ค่าตั้งเพิ่มเติมของ Dovecot — ไฟล์นี้เป็นของผู้ดูแลเครื่อง
#
# panel ไม่เขียนทับไฟล์นี้เลย · แก้จากหน้ากล่องจดหมายใน panel หรือแก้ไฟล์นี้ตรง ๆ ก็ได้
#
# สามข้อที่ควรรู้ก่อนเขียน
# -----------------------------------------------------------------------------
# 1. ไฟล์นี้ถูกอ่าน **ท้ายสุด** ต่อจาก 99-phpcp.conf ที่ panel สร้าง — เขียนเฉพาะค่าที่
#    ต้องการเปลี่ยนพอ ค่าที่เขียนที่นี่ชนะค่าเริ่มต้นเสมอ
#
# 2. เป็นค่าตั้งระดับบนสุดของ Dovecot (ไม่ได้อยู่ในบล็อกไหน) · คำสั่งที่ต้องอยู่ใน
#    บล็อกอย่าง `mailbox` ต้องเขียนบล็อกครอบมาเองให้ครบ
#
# 3. บันทึกแล้ว `doveconf -n` ต้องผ่านก่อนถึงจะมีผล · ผ่านแล้วยังต้องกดยืนยัน
#    ไม่งั้นระบบคืนค่าเดิมให้เอง
#
# **ระวังเป็นพิเศษ:** `ssl = required` กับพอร์ต imap/pop3 ที่ปิดไว้ (port = 0) คือสิ่งที่
# กันไม่ให้รหัสผ่านของลูกค้าวิ่งเป็นข้อความเปล่าผ่านเน็ต · เปิดกลับมาแล้วรหัสผ่านทุกกล่อง
# จะถูกส่งแบบอ่านได้ทุกครั้งที่โปรแกรมเมลเช็คกล่อง ซึ่งเกิดขึ้นทุกไม่กี่นาที
# -----------------------------------------------------------------------------

# ตัวอย่าง — ลบเครื่องหมาย # หน้าบรรทัดที่ต้องการใช้

# โควตาเริ่มต้นของกล่องที่ไม่ได้ระบุไว้รายกล่อง (panel ตั้งรายกล่องให้อยู่แล้ว)
#plugin {
#  quota_rule = *:storage=2G
#}

# เก็บ log ละเอียดขึ้นเวลาไล่ปัญหาการล็อกอิน — ปิดกลับเมื่อเสร็จ เพราะ log จะโตเร็วมาก
#auth_verbose = yes
#mail_debug = no

# จำนวนการเชื่อมต่อพร้อมกันต่อผู้ใช้หนึ่งคน
#mail_max_userip_connections = 20
