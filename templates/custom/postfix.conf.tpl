# ค่าตั้งเพิ่มเติมของ Postfix — ไฟล์นี้เป็นของผู้ดูแลเครื่อง
#
# panel ไม่เขียนทับไฟล์นี้เลย · แก้จากหน้ากล่องจดหมายใน panel หรือแก้ไฟล์นี้ตรง ๆ ก็ได้
#
# สามข้อที่ควรรู้ก่อนเขียน
# -----------------------------------------------------------------------------
# 1. **Postfix ไม่มีคำสั่ง include สำหรับ main.cf** เนื้อไฟล์นี้จึงถูก "ผนวก" ลงท้าย
#    main.cf ตอนที่ panel เขียนไฟล์นั้นใหม่ · เขียนที่นี่เท่านั้น อย่าไปแก้ main.cf
#    เพราะมันถูกสร้างใหม่ทั้งไฟล์ทุกครั้งที่มีการเปลี่ยนแปลงเรื่องเมล
#
# 2. Postfix ใช้ค่าที่ประกาศ **ทีหลัง** — เนื้อไฟล์นี้อยู่ท้ายสุด ค่าที่เขียนที่นี่จึง
#    ชนะค่าที่ panel ตั้งไว้เสมอ · เขียนเฉพาะค่าที่ต้องการเปลี่ยน ไม่ต้องคัดลอกมาทั้งชุด
#
# 3. บันทึกแล้ว `postfix check` ต้องผ่านก่อนถึงจะมีผล · ผ่านแล้วยังต้องกดยืนยัน
#    ไม่งั้นระบบคืนค่าเดิมให้เอง — การตรวจบอกแค่ว่าไวยากรณ์ถูก ไม่ได้บอกว่าเมลยังส่งได้
#
# **ระวังเป็นพิเศษ:** ค่าที่เกี่ยวกับ mynetworks, smtpd_relay_restrictions และ
# inet_interfaces คือเส้นแบ่งระหว่างเมลที่ปลอดภัยกับเครื่องส่งสแปม · เขียนผิดแล้วไอพี
# ติดบัญชีดำถาวรและกระทบทุกเว็บบนเครื่องเดียวกัน ไม่ใช่แค่เรื่องเมล
# -----------------------------------------------------------------------------

# ตัวอย่าง — ลบเครื่องหมาย # หน้าบรรทัดที่ต้องการใช้

# จำกัดขนาดเมลต่อฉบับ (ค่าเริ่มต้นของ panel คือ 25 MB)
#message_size_limit = 52428800

# เก็บเมลไว้ในคิวนานขึ้นก่อนยอมแพ้ (ค่าเริ่มต้นของ panel คือ 1 วัน)
#maximal_queue_lifetime = 3d
#bounce_queue_lifetime = 3d

# จำกัดจำนวนผู้รับต่อฉบับ — กันกล่องที่ถูกยึดไปใช้ส่งสแปมจำนวนมาก
#smtpd_recipient_limit = 100

# ปฏิเสธผู้ส่งที่โดเมนไม่มีจริง (เข้มขึ้น อาจปฏิเสธเมลที่ควรได้รับด้วย)
#smtpd_sender_restrictions = reject_unknown_sender_domain
